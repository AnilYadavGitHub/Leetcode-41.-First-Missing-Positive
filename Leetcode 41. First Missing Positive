class Solution {
public:
    int firstMissingPositive(vector<int>& nums) {
        
     unordered_set<int>st(nums.begin() , nums.end());
     
     int ans;
     for(int i = 1 ; i <= 100001 ; i++){
             if(st.find(i) == st.end()){
                 ans = i;
                 break;
             }
     }
     return ans;
    }
};
